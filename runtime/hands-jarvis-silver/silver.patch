diff --git a/showcase/panel/hands-page.js b/showcase/panel/hands-page.js
new file mode 100644
index 0000000..c06acdc
--- /dev/null
+++ b/showcase/panel/hands-page.js
@@ -0,0 +1,147 @@
+// HANDS JARVIS Silver control page. Declarative UI; no direct privileged operations.
+(() => {
+  'use strict';
+  window.HandsSilverPanel = {
+    create({ el, group, btn, link, invoke, act, note, redraw }) {
+      let live = { connected: false, projects: [], total: 0, error: 'Not checked yet' };
+      let installedModules = [], modulesLoaded = false;
+      let draft = '', recent = [], loading = false, poll = null;
+      let lowPower = false;
+      try { lowPower = localStorage.getItem('hands-silver-low-power') === '1'; } catch {}
+      document.body.classList.toggle('hands-low-power', lowPower);
+      let docked = false;
+      try { docked = localStorage.getItem('hands-silver-dock') === '1'; } catch {}
+      const presets = [
+        ['Visual Studio', 'Open HANDS Visual Studio and show me the active render queue.'],
+        ['Video Analyzer', 'Open HANDS Video Analyzer. Help me analyze a video and its visual style.'],
+        ['True Voice', 'Open HANDS True Voice and show the available voice synthesis controls.'],
+        ['Mission Control', 'Show my active HANDS jobs and failures in Live Mission Control.']
+      ];
+      const stamp = () => new Date().toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit' });
+      const refresh = async () => {
+        if (loading) return;
+        loading = true;
+        if (!modulesLoaded) {
+          try {
+            const found = await invoke('hands_modules');
+            if (Array.isArray(found)) { installedModules = found; modulesLoaded = true; }
+          } catch { /* native module listing is unavailable in browser preview */ }
+        }
+        try {
+          const result = await invoke('hands_snapshot');
+          if (result && typeof result === 'object' && Array.isArray(result.projects)) {
+            live = result;
+          } else {
+            live = { connected: false, projects: [], total: 0, error: 'Requires the compiled HANDS JARVIS Silver app' };
+          }
+        } catch (err) {
+          live = { connected: false, projects: [], total: 0, error: String(err?.message || err) };
+        } finally { loading = false; redraw(); }
+      };
+      const activate = (name) => {
+        if (poll) { clearInterval(poll); poll = null; }
+        if (name === 'hands') {
+          refresh();
+          invoke('hands_dock', { on: docked }).catch(() => {});
+          poll = setInterval(() => { if (!document.hidden) refresh(); }, 6000);
+        }
+      };
+      const open = async () => {
+        try {
+          const ok = await invoke('hands_open');
+          note(ok ? 'Requested HANDS app launch.' : 'HANDS could not be opened.', !ok);
+        } catch { note('HANDS app launch requires the compiled macOS companion.', true); }
+      };
+      const handoff = async (value) => {
+        const text = String(value || '').trim();
+        if (!text || text.length > 1200) { note('Enter a request (maximum 1200 characters).', true); return; }
+        try {
+          const response = await invoke('hands_handoff', { prompt: text });
+          if (!response?.copied) throw Error('Clipboard handoff was not confirmed');
+          recent.unshift({ text, at: stamp() }); recent = recent.slice(0, 4);
+          note(response.opened ? 'Copied. Paste into HANDS to review and run.' : 'Copied. Open HANDS and paste to continue.');
+          redraw();
+        } catch (err) { note('Handoff unavailable: ' + String(err?.message || err), true); }
+      };
+      const choice = (title, text) => btn(title, () => { draft = text; redraw(); }, { k: 'hands-workflow-' + title.toLowerCase().replace(/[^a-z]+/g, '-') });
+      const meter = (p) => {
+        const v = Math.min(100, Math.max(0, Number(p.progress) || 0));
+        const qa = p.qa || {};
+        const state = p.active ? 'Rendering' : p.finished ? 'Exported' : 'Not rendering';
+        const title = el('div', { className: 'hands-project-title' },
+          el('strong', { textContent: p.name || 'Untitled' }),
+          el('span', { textContent: String(Math.round(v)) + '%' }));
+        const meta = el('div', { className: 'hands-project-meta', textContent:
+          state + (p.stage ? ' · ' + p.stage : '') + ((qa.fail || qa.warn) ? ' · QA ' + (qa.fail || 0) + ' failed / ' + (qa.warn || 0) + ' warnings' : '') });
+        return el('li', { className: 'hands-project' }, title,
+          el('progress', { className: 'hands-progress', max: 100, value: v, 'aria-label': 'Render progress for ' + p.name }),
+          meta);
+      };
+      function page(state) {
+        const command = el('textarea', { className: 'hands-prompt', rows: 3,
+          value: draft, placeholder: 'Ask HANDS to open a tool, analyze a video, continue a project…',
+          'aria-label': 'Request for HANDS', maxLength: 1200,
+          on: { input: (e) => { draft = e.target.value; } } });
+        const projects = (live.projects || []).slice().sort((a, b) => Number(b.active) - Number(a.active));
+        return [
+          group('HANDS CONTROLLER', 'A direct path to your existing HANDS tools. Permissions remain with HANDS.', null,
+            el('div', { className: 'hands-connection' },
+              el('span', { className: 'hands-signal' + (live.connected ? ' on' : '') }),
+              el('span', { textContent: live.connected ? 'Visual Studio connected · ' + live.total + ' projects' : 'Visual Studio offline' })),
+            el('div', { className: 'actions' }, btn('Open HANDS', open, { kind: 'primary', k: 'hands-open' }),
+              btn('Refresh status', refresh, { k: 'hands-refresh', disabled: loading })),
+            !live.connected ? el('p', { className: 'hands-hint', textContent: live.error || 'Start HANDS Visual Studio to see live projects.' }) : null),
+          installedModules.length ? group('Installed HANDS tools', 'Discovered locally from your installed module manifests; select one to prepare a handoff.', installedModules.length,
+            el('div', { className: 'hands-presets' },
+              installedModules.slice(0, 24).map((tool) => choice(tool.name,
+                'Open my installed HANDS tool named ' + tool.name + ' and show its available actions.')))) : null,
+          group('Quick command', 'Choose a workflow or type a request. Handoff copies text; you review and submit it inside HANDS.', null,
+            el('div', { className: 'hands-presets' }, presets.map(([name, text]) => choice(name, text))),
+            command,
+            el('div', { className: 'actions' },
+              btn('Copy + open HANDS', () => handoff(draft), { kind: 'primary', k: 'hands-send' }),
+              link('Clear', () => { draft = ''; redraw(); }, { k: 'hands-clear' }))),
+          group('Live render queue', live.connected ? 'Read-only project statuses from HANDS Visual Studio, refreshed every six seconds.' : 'No guessed percentages or placeholder jobs.', live.connected ? live.total : null,
+            projects.length ? el('ul', { className: 'hands-projects' }, projects.slice(0, 10).map(meter))
+              : el('p', { className: 'hands-hint', textContent: live.connected ? 'No render projects reported.' : 'Connect to HANDS Visual Studio to see real render progress.' })),
+          group('Privacy and control', 'JARVIS respects the existing Roamies and HANDS permissions. HANDS actions always need their own authorization.', null,
+            el('div', { className: 'hands-privacy' },
+              el('span', { textContent: 'Microphone' }), el('strong', { textContent: state.voice?.on ? 'Enabled' : 'Off' }),
+              btn(state.voice?.on ? 'Disable microphone' : 'Voice settings', () => state.voice?.on ? act('voice') : (document.getElementById('nav-voice')?.click()), { k: 'hands-mic' }),
+              el('span', { textContent: 'Roamies file / computer actions' }), el('strong', { textContent: state.actions ? 'Enabled' : 'Off' }),
+              btn(state.actions ? 'Disable actions' : 'Behavior settings', () => state.actions ? act('actions') : (document.getElementById('nav-behavior')?.click()), { k: 'hands-actions' })),
+            btn('Stop reply + disable mic/actions', () => {
+              act('stop');
+              if (state.voice?.on) act('voice');
+              if (state.actions) act('actions');
+              note('Requested pause. Running external HANDS jobs may continue; use Mission Control to manage them.');
+            }, { k: 'hands-pause' })),
+          group('Floating orb', 'Dock JARVIS along the nearest screen edge while idle.', null,
+            el('div', { className: 'setting' },
+              el('span', {}, 'Edge docking', el('small', { textContent: 'Dragging and normal HANDS work still take priority.' })),
+              btn(docked ? 'On' : 'Off', async () => {
+                const desired = !docked;
+                try {
+                  await invoke('hands_dock', { on: desired });
+                  docked = desired;
+                  try { localStorage.setItem('hands-silver-dock', docked ? '1' : '0'); } catch {}
+                  redraw();
+                } catch { note('Docking requires the compiled JARVIS companion.', true); }
+              }, { k: 'hands-dock' }))),
+          group('Performance', 'Lower animation activity when you prefer a quieter panel.', null,
+            el('div', { className: 'setting' },
+              el('span', {}, 'Low-power animation', el('small', { textContent: 'Limits panel animation updates; does not affect HANDS renders.' })),
+              btn(lowPower ? 'On' : 'Off', () => {
+                lowPower = !lowPower; document.body.classList.toggle('hands-low-power', lowPower);
+                try { localStorage.setItem('hands-silver-low-power', lowPower ? '1' : '0'); } catch {}
+                redraw();
+              }, { k: 'hands-power' }))),
+          recent.length ? group('Recent handoffs', 'This panel session only. HANDS maintains its own project history.', recent.length,
+            el('ul', { className: 'hands-recent' }, recent.map((r) =>
+              el('li', {}, el('span', { textContent: r.text }), el('small', { textContent: r.at }))))) : null
+        ].filter(Boolean);
+      }
+      return { page, activate, refresh };
+    }
+  };
+})();
diff --git a/showcase/panel/hands-silver.css b/showcase/panel/hands-silver.css
new file mode 100644
index 0000000..cbdbc75
--- /dev/null
+++ b/showcase/panel/hands-silver.css
@@ -0,0 +1,67 @@
+/* HANDS JARVIS Silver · restrained chrome, graphite and polished platinum */
+:root {
+  --bg: #080b11;
+  --panel: #101723;
+  --ink: #f3f7fc;
+  --ink-2: #c1ccd9;
+  --ink-3: #8795a8;
+  --accent: #d2ddeb;
+  --accent-hi: #f9fbff;
+  --accent-lo: #a1b0c2;
+  --accent-ink: #101723;
+  --line: #334052;
+  --line-hi: #66768d;
+  --line-hot: #b0bfd2;
+}
+.frame {
+  background:
+    radial-gradient(ellipse 80% 18% at 53% 0%, rgba(231,239,255,.13), transparent 75%),
+    radial-gradient(circle at 50% 50%, rgba(190,203,221,.055) .85px, transparent 1.3px) 0 0 / 10px 10px,
+    linear-gradient(160deg,#111926 0%,#080b12 65%,#111721 100%);
+  border-color: #5b687c;
+}
+.avatar, .maker canvas {
+  background: radial-gradient(closest-side,rgba(227,235,246,.12),transparent) 50% 92%/70% 22% no-repeat;
+}
+.looktile[aria-checked="true"] { --fill: #182231; }
+.hands-connection {
+  display: flex; gap: 9px; align-items: center; margin: 2px 0 12px;
+  color: var(--ink-2); font: 600 11px/1.4 var(--mono);
+}
+.hands-signal { width: 8px; height: 8px; border-radius: 50%; background: #6c7582; box-shadow: 0 0 0 2px #1f2631; }
+.hands-signal.on { background: #cce5ee; box-shadow: 0 0 9px #8dabb9; }
+.hands-hint { color: var(--ink-3); font-size: 11px; line-height: 1.5; margin: 8px 0; }
+.hands-presets { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 7px; margin: 4px 0 12px; }
+.hands-presets .btn { width: 100%; min-height: 33px; }
+.hands-prompt {
+  display: block; width: 100%; min-height: 82px; padding: 12px; margin: 2px 0 10px;
+  font: 500 12px/1.5 var(--mono); resize: vertical; color: var(--ink);
+  background: linear-gradient(140deg,#1c2431,#0c121b);
+  border: 1px solid #58677a; border-radius: 7px; outline: none;
+  box-shadow: inset 0 1px 3px #03060a, 0 1px rgba(255,255,255,.08);
+}
+.hands-prompt:focus-visible { border-color: #dfebfa; box-shadow: 0 0 0 2px rgba(201,224,247,.2); }
+.hands-prompt::placeholder { color: #8491a3; }
+.hands-projects, .hands-recent { list-style: none; padding: 0; margin: 0; display: grid; gap: 9px; }
+.hands-project {
+  display: grid; gap: 6px; padding: 10px; border: 1px solid #384559; border-radius: 8px;
+  background: linear-gradient(155deg,rgba(233,242,255,.08),rgba(11,17,28,.35) 70%);
+}
+.hands-project-title { display: flex; justify-content: space-between; gap: 10px; align-items: start; }
+.hands-project-title strong { overflow-wrap: anywhere; font: 700 11px/1.4 var(--mono); color: #edf4ff; }
+.hands-project-title span { font: 700 11px/1.3 var(--mono); color: #dce8f7; }
+.hands-progress { display: block; width: 100%; height: 6px; appearance: none; -webkit-appearance: none; border: 0; background: #303a49; border-radius: 4px; }
+.hands-progress::-webkit-progress-bar { background: #303a49; border-radius: 4px; }
+.hands-progress::-webkit-progress-value { background: linear-gradient(90deg,#637184 0%,#c0cedf 65%,#f6faff 100%); border-radius: 4px; box-shadow: 0 0 8px rgba(207,222,242,.26); }
+.hands-project-meta { font-size: 10px; color: #a0b0c3; }
+.hands-privacy { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 5px 8px; margin-bottom: 12px; }
+.hands-privacy span { color: var(--ink-2); }
+.hands-privacy strong { font-size: 11px; color: var(--ink); text-align: right; }
+.hands-privacy .btn { grid-column: 1 / -1; justify-self: start; margin-bottom: 7px; }
+.hands-recent li { display: flex; gap: 12px; justify-content: space-between; border-bottom: 1px solid #344154; padding: 6px 0; overflow-wrap: anywhere; }
+.hands-recent li span { min-width: 0; }
+.hands-recent li small { color: var(--ink-3); white-space: nowrap; }
+.hands-low-power .frame.opening, .hands-low-power .frame.shutting, .hands-low-power .pane.enter > * { animation: none !important; }
+@media (prefers-reduced-motion: reduce) {
+  .hands-project, .hands-progress { transition: none !important; animation: none !important; }
+}
