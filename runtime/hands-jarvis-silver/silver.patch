diff --git a/showcase/tauri/src-tauri/src/hands.rs b/showcase/tauri/src-tauri/src/hands.rs
new file mode 100644
index 0000000..ff1c310
--- /dev/null
+++ b/showcase/tauri/src-tauri/src/hands.rs
@@ -0,0 +1,154 @@
+// HANDS JARVIS Silver integration.
+// Fixed, read-only, loopback render status and explicit user-initiated HANDS handoff.
+// No shell interpolation, network-facing listener, credentials, or arbitrary commands.
+use serde_json::{json, Value};
+use std::io::Write;
+use std::process::{Command, Stdio};
+
+fn safe_render_status(raw: &Value) -> Option<Value> {
+    let projects = raw.get("projects")?.as_array()?;
+    let items: Vec<Value> = projects.iter().take(40).map(|p| {
+        let stage = p.get("stages").and_then(Value::as_array).and_then(|stages| {
+            stages.iter().find(|s| {
+                matches!(
+                    s.get("status").and_then(Value::as_str),
+                    Some("running") | Some("active") | Some("in_progress")
+                )
+            }).and_then(|s| s.get("name")).and_then(Value::as_str)
+        }).unwrap_or("");
+        json!({
+            "id": p.get("id").and_then(Value::as_str).unwrap_or(""),
+            "name": p.get("name").and_then(Value::as_str).unwrap_or("Untitled"),
+            "progress": p.get("progress").and_then(Value::as_f64).unwrap_or(0.0).clamp(0.0, 100.0),
+            "state": p.get("state").and_then(Value::as_str).unwrap_or("unknown"),
+            "active": p.get("processActive").and_then(Value::as_bool).unwrap_or(false),
+            "finished": p.get("filmExists").and_then(Value::as_bool).unwrap_or(false),
+            "stage": stage,
+            "qa": {
+                "pass": p.pointer("/qaCounts/pass").and_then(Value::as_u64).unwrap_or(0),
+                "warn": p.pointer("/qaCounts/warn").and_then(Value::as_u64).unwrap_or(0),
+                "fail": p.pointer("/qaCounts/fail").and_then(Value::as_u64).unwrap_or(0)
+            },
+            "updated": p.get("outputUpdatedAt").and_then(Value::as_str).unwrap_or("")
+        })
+    }).collect();
+    Some(json!({"connected": true, "projects": items, "total": projects.len()}))
+}
+
+#[tauri::command]
+pub(crate) fn hands_snapshot() -> Value {
+    // The Visual Studio daemon is the source of truth. Never invent progress values.
+    // No user-supplied URL is accepted: SSRF and LAN discovery are not supported.
+    let output = Command::new("curl")
+        .args(["--silent", "--show-error", "--fail", "--max-time", "2",
+               "--noproxy", "*", "http://127.0.0.1:5127/api/render-projects"])
+        .output();
+    match output {
+        Ok(o) if o.status.success() && o.stdout.len() <= 1_500_000 => {
+            let status = serde_json::from_slice::<Value>(&o.stdout)
+                .ok().and_then(|v| safe_render_status(&v));
+            status.unwrap_or_else(|| json!({"connected": false, "projects": [], "error": "Invalid Visual Studio status response"}))
+        }
+        _ => json!({"connected": false, "projects": [], "error": "HANDS Visual Studio is offline or unavailable"})
+    }
+}
+
+/// Lists only installed HANDS module names/IDs, not account identifiers or file paths.
+#[tauri::command]
+pub(crate) fn hands_modules() -> Vec<Value> {
+    use std::fs;
+    let home = match std::env::var("HOME") { Ok(home) => home, Err(_) => return vec![] };
+    let accounts = std::path::Path::new(&home)
+        .join("Library/Application Support/HANDS for GPT/modules-v1/accounts");
+    let mut result = Vec::new();
+    let Ok(roots) = fs::read_dir(accounts) else { return result };
+    for root in roots.flatten().take(3) {
+        if !root.path().is_dir() { continue; }
+        let Ok(modules) = fs::read_dir(root.path()) else { continue };
+        for entry in modules.flatten().take(80) {
+            if !entry.path().is_dir() { continue; }
+            let path = entry.path().join("manifest.json");
+            let Ok(bytes) = fs::read(&path) else { continue };
+            if bytes.len() > 16_384 { continue; }
+            let Ok(data) = serde_json::from_slice::<Value>(&bytes) else { continue };
+            let (Some(id), Some(name)) = (
+                data.get("id").and_then(Value::as_str),
+                data.get("name").and_then(Value::as_str)
+            ) else { continue };
+            if id.len() > 50 || name.len() > 90 || !id.chars().all(|c| c.is_ascii_lowercase() || c.is_ascii_digit() || c == '-') {
+                continue;
+            }
+            result.push(json!({ "id": id, "name": name }));
+            if result.len() == 40 { break; }
+        }
+        if result.len() == 40 { break; }
+    }
+    result.sort_by(|a, b| {
+        let ax = a.get("name").and_then(Value::as_str).unwrap_or("");
+        let bx = b.get("name").and_then(Value::as_str).unwrap_or("");
+        ax.to_ascii_lowercase().cmp(&bx.to_ascii_lowercase())
+    });
+    result
+}
+
+#[tauri::command]
+pub(crate) fn hands_open() -> Result<bool, String> {
+    #[cfg(target_os = "macos")]
+    {
+        let status = Command::new("/usr/bin/open").args(["-a", "HANDS for GPT"])
+            .status().map_err(|_| "Could not locate the HANDS application".to_string())?;
+        return Ok(status.success());
+    }
+    #[cfg(not(target_os = "macos"))]
+    {
+        Err("Automatic application opening is currently supported only on macOS".into())
+    }
+}
+
+#[tauri::command]
+pub(crate) fn hands_handoff(prompt: String) -> Result<Value, String> {
+    // Explicit user click only. Copy a bounded prompt, open HANDS, and let the user
+    // paste/approve it there. Do not call privileged tools or simulate Enter.
+    let trimmed = prompt.trim();
+    if trimmed.is_empty() || trimmed.chars().count() > 1200 {
+        return Err("Enter a request of 1–1200 characters".into());
+    }
+    #[cfg(target_os = "macos")]
+    {
+        let mut child = Command::new("/usr/bin/pbcopy").stdin(Stdio::piped())
+            .spawn().map_err(|_| "Clipboard is unavailable".to_string())?;
+        if let Some(mut input) = child.stdin.take() {
+            input.write_all(trimmed.as_bytes())
+                .map_err(|_| "Could not copy the request".to_string())?;
+        }
+        if !child.wait().map_err(|_| "Clipboard command failed".to_string())?.success() {
+            return Err("Could not copy the request".into());
+        }
+        let opened = hands_open()?;
+        return Ok(json!({"copied": true, "opened": opened, "requiresPaste": true}));
+    }
+    #[cfg(not(target_os = "macos"))]
+    {
+        Err("HANDS prompt handoff is currently supported only on macOS".into())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn only_safe_status_fields_leave_the_bridge() {
+        let raw = json!({"projects":[{"id":"episode:1","name":"Film","progress":125,
+            "dir":"/private/path","issues":[{"secret":"no"}],
+            "qaCounts":{"pass":3,"warn":1,"fail":0},"filmExists":true}]});
+        let out = safe_render_status(&raw).expect("valid data");
+        assert_eq!(out["projects"][0]["progress"], 100.0);
+        assert_eq!(out["projects"][0]["qa"]["warn"], 1);
+        assert!(out["projects"][0].get("dir").is_none());
+        assert!(out["projects"][0].get("issues").is_none());
+    }
+    #[test]
+    fn rejects_unknown_status_shape() {
+        assert!(safe_render_status(&json!({"messages":"wrong type"})).is_none());
+    }
+}
